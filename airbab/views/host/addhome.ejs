<%- include('../partials/head') %>
  <body>
    <%- include('../partials/nav') %>

    <main class="page-wrapper" style="padding-top: 40px; padding-bottom: 80px; display:flex; align-items:flex-start; justify-content:center; min-height: calc(100vh - 68px);">
      <div class="form-container form-container--wide anim-fadeUp">

        <div class="form-header">
          <div class="form-header__icon">
            <i class="fa-solid fa-<%= editing ? 'pen' : 'house-chimney-medical' %>"></i>
          </div>
          <h1 class="form-header__title"><%= editing ? 'Edit Your Listing' : 'List Your Home' %></h1>
          <p class="form-header__subtitle">
            <%= editing ? 'Update your property details below.' : 'Fill in the details to register your property on Airbab.' %>
          </p>
        </div>

        <form action="<%= editing ? '/host/edit-home' : '/host/add-home' %>" method="POST">
          <% if (editing) { %>
            <input type="hidden" name="id" value="<%= home._id %>" />
          <% } %>

          <div class="form-group--row">
            <div class="form-group">
              <label class="form-label">House Name</label>
              <input type="text" name="houseName" placeholder="e.g. Sunset Villa"
                value="<%= editing ? home.houseName : '' %>"
                class="form-control" required />
            </div>
            <div class="form-group">
              <label class="form-label">Price Per Night (Rs)</label>
              <input type="text" name="price" placeholder="e.g. 5000"
                value="<%= editing ? home.price : '' %>"
                class="form-control" required />
            </div>
          </div>

          <div class="form-group--row">
            <div class="form-group">
              <label class="form-label">Location</label>
              <input type="text" name="location" placeholder="e.g. Lahore, Pakistan"
                value="<%= editing ? home.location : '' %>"
                class="form-control" required />
            </div>
            <div class="form-group">
              <label class="form-label">Rating (0–5)</label>
              <input type="text" name="rating" placeholder="e.g. 4.8"
                value="<%= editing ? home.rating : '' %>"
                class="form-control" required />
            </div>
          </div>

          <div class="form-group">
            <label class="form-label">Photo URL</label>
            <input type="text" name="photoUrl" placeholder="https://example.com/photo.jpg"
              value="<%= editing ? home.photoUrl : '' %>"
              class="form-control" required />
          </div>

          <div class="form-group">
            <label class="form-label">Description</label>
            <textarea name="description" placeholder="Describe your property — amenities, vibe, neighbourhood…"
              class="form-control"><%= editing ? home.description : '' %></textarea>
          </div>

          <div style="margin-top: 8px;">
            <input type="submit"
              value="<%= editing ? 'Update Listing' : 'Publish Listing' %>"
              class="btn btn-primary btn-full btn-lg" style="cursor:pointer;" />
          </div>
        </form>

        <% if (!editing) { %>
          <div class="form-footer">
            Already hosting? <a href="/host/host-home-list">View your listings</a>
          </div>
        <% } %>
      </div>
    </main>

    <footer class="footer">© <%= new Date().getFullYear() %> <a href="/">Airbab</a></footer>
  </body>
</html>
